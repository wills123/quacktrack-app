# Copy this file to .env and customize values

# Each container gets only the settings it needs: docker-compose.yml and docker-compose.release.yml pass the
# application settings below to PHP through an allowlist (x-php-app-env) and the MYSQL_* ones to the database only.
# A new application setting must be added to that allowlist as well as here.

# Directory holding the nginx trusted-proxy files (nginx/trusted-proxies/README.md); compose default shown.
# QT_TRUSTED_PROXIES_DIR=/etc/quacktrack/trusted-proxies

# App
APP_ENV=prod
# Public origin used for password-reset links; required for APP_ENV=prod or production.
APP_URL=https://quacktrack.example.com
# Behind HTTPS termination, explicitly set SESSION_COOKIE_SECURE=1 in the deployed environment.
# SESSION_COOKIE_SECURE=1
# Required, at least 32 random characters (openssl rand -hex 32). It encrypts stored Snipe-IT
# tokens; the app refuses to handle them with a missing, short or placeholder value.
# To rotate it, put the old value in APP_SECRET_PREVIOUS until users have been rewritten, then remove it.
# Rotating without APP_SECRET_PREVIOUS makes stored tokens unreadable and users must reconnect.
APP_SECRET=change_this_to_a_random_long_string
# APP_SECRET_PREVIOUS=
# First administrator, created once with app/create_admin.php (see README). The password needs 12+ characters with
# upper and lower case, a number and a symbol; remove it from .env once the account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PURCHASING_EMAIL=purchasing@company.com

# PHP
PHP_MEMORY_LIMIT=256M
UPLOAD_MAX_FILESIZE=100M
POST_MAX_SIZE=100M

# MySQL
MYSQL_ROOT_PASSWORD=ChangeRootPass123!
MYSQL_DATABASE=parts_shop
MYSQL_USER=parts_user
MYSQL_PASSWORD=ChangeDbPass123!

# The app talks to MySQL over TLS and verifies the server against a private CA that docker compose
# generates (see doc/operations/DATABASE_SECURITY.md); the compose files set DB_SSL_CA for you. A plain-text
# connection is only accepted when APP_ENV=dev or this is set to 1.
DB_ALLOW_PLAINTEXT=0
# Staged rollout only: while an older release that cannot use TLS is still serving traffic, keep the
# database from refusing plain-text connections. Remove it once every client uses TLS.
# DB_REQUIRE_TLS_CNF=./docker/mysql/optional-tls.cnf

# Maximum quantity per SKU in a single order/cart entry
MAX_ORDER_QUANTITY=100

# Enable or disable checkout validation (set to 0 to skip stock/status checks)
CHECKOUT_VALIDATION_ENABLED=1

# Cloudflare Turnstile (bot protection for registration/login/password reset)
# Set to 1 to enable, 0 to disable (default: 0 for development)
TURNSTILE_ENABLED=0
# These are Cloudflare's documented test keys (they always pass). Put the real keys for your site in .env only.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Registration Page Side Images (optional - leave blank to hide)
# Use absolute URLs (https://...) or relative paths (/assets/...)
# Recommended size: 400x600px or larger (vertical orientation)
REGISTER_LEFT_IMAGE=
REGISTER_RIGHT_IMAGE=

# Login Page Side Images (optional - leave blank to hide)
# Use absolute URLs (https://...) or relative paths (/assets/...)
# Recommended size: 400x500px or larger (vertical orientation)
LOGIN_LEFT_IMAGE=
LOGIN_RIGHT_IMAGE=

# Snipe IT Asset Management Integration
# Set SNIPE_IT_ENABLED=1 to activate Snipe IT asset browsing, checkout, and reporting
SNIPE_IT_ENABLED=0
SNIPE_IT_API_URL=https://your-snipe-it-url/api/v1
SNIPE_IT_API_KEY=your-api-key-here
SNIPE_IT_API_TIMEOUT=15
SNIPE_IT_CACHE_TTL=300
# The Snipe-IT URLs must be https. Plain http is only accepted when APP_ENV=dev, or when this is 1.
SNIPE_IT_ALLOW_INSECURE_HTTP=0
# Longest we keep using one personal OAuth access token before rotating it, in seconds (0 = use Snipe-IT's expiry).
SNIPE_TOKEN_MAX_AGE=86400
# Days of Snipe-IT API call history kept in snipe_it_sync_log (0 = keep forever).
SNIPE_SYNC_LOG_RETENTION_DAYS=90

# Snipe IT OAuth SSO (optional - set SNIPE_IT_OAUTH_ENABLED=1 to enable single sign-on)
# SNIPE_IT_OAUTH_BASE_URL also drives the "Open Snipe-IT" link on the Assets page.
# If not set, the base URL is derived from SNIPE_IT_API_URL by stripping /api/v1.
SNIPE_IT_OAUTH_ENABLED=0
SNIPE_IT_OAUTH_CLIENT_ID=
SNIPE_IT_OAUTH_CLIENT_SECRET=
SNIPE_IT_OAUTH_REDIRECT_URI=https://your-quacktrack-url/api/snipe-oauth-callback.php
SNIPE_IT_OAUTH_BASE_URL=https://your-snipe-it-url

# Acumatica ERP Integration (generic -- live stock levels, shipment tracking,
# and purchase-order creation; usable by any feature, not just kits)
# Purchase orders created through this integration always land in Acumatica
# on Hold; Quack Track never releases a PO itself.
ACUMATICA_ENABLED=0
ACUMATICA_API_URL=https://your-acumatica-url
# Credentials are sent to this URL, so it must be https://. Plain http:// is accepted only when
# APP_ENV=dev or this is set to 1 (a deliberate opt-out for a LAN-only instance without TLS).
ACUMATICA_ALLOW_INSECURE_HTTP=0
ACUMATICA_ENDPOINT_NAME=Default
ACUMATICA_API_VERSION=25.200.001
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_COMPANY=
ACUMATICA_BRANCH=
ACUMATICA_API_TIMEOUT=30
ACUMATICA_CACHE_TTL=300

# QuickQueue integration (ConnectWise Project lookup for the Deployment Quest Log)
# QuickQueue owns the ConnectWise connection; Quack Track calls QuickQueue's read API,
# never ConnectWise directly. Token comes from a dedicated service account in QuickQueue.
QUICKQUEUE_API_BASE_URL=https://your-quickqueue-url
# The bearer token is sent to this URL, so it must be https://. Same opt-out rule as Acumatica.
QUICKQUEUE_ALLOW_INSECURE_HTTP=0
QUICKQUEUE_API_TOKEN=
QUICKQUEUE_API_TIMEOUT=15

# Optional client-error telemetry header credential; leave blank to permit session auth only.
CLIENT_ERROR_API_KEY=
CLIENT_ERROR_RATE_LIMIT_MAX=60
CLIENT_ERROR_RATE_LIMIT_DIR=/tmp/quacktrack-client-errors

# Corporate deployment: set LOCAL_AUTH_ENABLED=0 after approved SSO is configured.
# SSO accounts never accept local credentials, even when local accounts are enabled.
LOCAL_AUTH_ENABLED=1
# Public registration requires deliberate opt-in; leave disabled for company deployment.
PUBLIC_REGISTRATION_ENABLED=0

# Production SSO admission is explicit; even opt-in new accounts start as guest.
SNIPE_IT_SSO_AUTO_PROVISION=0
# Authentication abuse limits persist for 15 minutes across cookies.
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_RECOVERY_IP_LIMIT=20
AUTH_RECOVERY_ACCOUNT_LIMIT=3
# Bind HTTP backends to loopback; expose only an approved HTTPS ingress.
QT_BIND_ADDRESS=127.0.0.1
ROUTER_BIND_ADDRESS=127.0.0.1

# Optional company OpenID Connect login (for example a single-tenant Microsoft Entra application).
# Set exact HTTPS issuer and callback URLs. Never use a multi-tenant /common or /organizations issuer.
SSO_ENABLED=0
SSO_REQUIRED=0
SSO_DISPLAY_NAME=Company SSO
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=
SSO_SESSION_MAX_AGE=3600

# Leave empty for the existing local DB. Set the approved hardened image only after the upgrade runbook.
QT_MYSQL_IMAGE=
