{
    "name": "quack-track/inventory-system",
    "description": "Docker-based inventory and order management system",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "phpoffice/phpspreadsheet": "~5.8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "slevomat/coding-standard": "^8.22.1",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "files": []
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml app/",
        "phpcbf": "phpcbf --standard=phpcs.xml app/",
        "phpcs:strict": "phpcs --standard=phpcs-strict.xml --file-list=phpcs-strict-files.txt",
        "phpcs:strict-report": "phpcs --standard=phpcs-strict.xml --report=summary --runtime-set ignore_errors_on_exit 1 app/",
        "duplication": "@php tools/quality/duplication.php --files=phpcs-strict-files.txt",
        "duplication:report": "@php tools/quality/duplication.php",
        "quality": "@php tools/quality/metrics.php --files=phpcs-strict-files.txt",
        "quality:report": "@php tools/quality/metrics.php",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "test:regression": [
            "@php tests/forms_validation_test.php",
            "@php tests/csv_export_test.php",
            "@php tests/security_regression_test.php",
            "@php tests/snipe_response_test.php",
            "@php tests/snipe_security_test.php",
            "@php tests/snipe_oauth_callback_test.php",
            "@php tests/snipe_disconnect_test.php",
            "@php tests/snipe_client_test.php",
            "@php tests/outbound_http_test.php",
            "@php tests/db_tls_test.php",
            "@php tests/quickqueue_contract_test.php",
            "@php tests/external_orders_input_test.php",
            "@php tests/admin_links_test.php",
            "@php tests/admin_routing_test.php",
            "@php tests/request_input_test.php",
            "@php tests/api_errors_test.php",
            "@php tests/cart_input_test.php",
            "@php tests/order_details_input_test.php",
            "@php tests/scan_product_input_test.php",
            "@php tests/templates_input_test.php",
            "@php tests/profile_completion_input_test.php",
            "@php tests/deployment_input_test.php",
            "@php tests/favorites_input_test.php",
            "@php tests/checkout_test.php",
            "@php tests/purchasing_emails_input_test.php",
            "@php tests/email_helper_input_test.php",
            "@php tests/quackmap_stores_input_test.php",
            "@php tests/stock_input_test.php",
            "@php tests/survey_design_input_test.php",
            "@php tests/survey_responses_input_test.php",
            "@php tests/survey_media_reporting_input_test.php",
            "@php tests/transactions_input_test.php",
            "@php tests/powerbi_input_test.php",
            "@php tests/forms_input_test.php",
            "@php tests/change_password_input_test.php",
            "@php tests/client_error_logging_input_test.php",
            "@php tests/products_input_test.php",
            "@php tests/snipe_catalog_input_test.php",
            "@php tests/tracked_assets_input_test.php",
            "@php tests/snipe_review_input_test.php",
            "@php tests/quackmap_assets_input_test.php",
            "@php tests/snipe_detail_history_input_test.php",
            "@php tests/snipe_writes_input_test.php",
            "@php tests/snipe_reports_input_test.php",
            "@php tests/acumatica_input_test.php",
            "@php tests/orders_browse_input_test.php",
            "@php tests/kit_templates_input_test.php",
            "@php tests/orders_status_receipts_input_test.php",
            "@php tests/travel_input_test.php",
            "@php tests/input_schema_test.php",
            "@php tests/schema_drift_test.php",
            "@php tests/pdo_errmode_test.php",
            "@php tests/architecture_rules_test.php",
            "@php tests/duplication_test.php",
            "@php tests/quality_metrics_test.php",
            "@php tests/fuzz_runner_test.php"
        ],
        "test": [
            "@test:regression",
            "@phpcs",
            "@phpcs:strict",
            "@duplication",
            "@quality",
            "@phpstan"
        ],
        "fix": "@phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
