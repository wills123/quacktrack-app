# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
#
# Immutable release image for the app's nginx: config and static files baked in.
# /var/www/html/uploads is a runtime volume (mounted read-only by compose).
# Images are pinned by digest (audit H2); doc/operations/IMAGE_PINS.md says how to update them.
FROM nginx:1.30.6-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY app /var/www/html/app
COPY assets /var/www/html/assets
