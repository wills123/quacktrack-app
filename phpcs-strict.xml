<?xml version="1.0"?>
<ruleset name="Quack Track strict rules">
    <description>
        Extra quality rules (Slevomat) on top of phpcs.xml. They block CI for the files listed in
        phpcs-strict-files.txt (code that is converted and covered by the API fuzz) and are reported,
        without failing, for the rest of app/. A file joins the list once it passes, and never leaves it.
    </description>

    <!-- Readability: how hard a function is to follow, and how long it is (code lines only). -->
    <rule ref="SlevomatCodingStandard.Complexity.Cognitive">
        <properties>
            <property name="warningThreshold" value="10"/>
            <property name="errorThreshold" value="15"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.FunctionLength">
        <properties>
            <property name="maxLinesLength" value="60"/>
        </properties>
    </rule>

    <!-- Dead code. -->
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>

    <!-- Native type declarations, and no docblock that only repeats them. Array shapes are left to
         PHPStan, which already ignores missing iterable value types (phpstan.neon). -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingTraversableTypeHintSpecification"/>
    </rule>

    <!-- Flatter control flow. A lone `if` that ends a function (a guard such as the CSRF check), and
         a trailing `if` with a single statement, are left alone; turning them inside out reads worse. SlevomatCodingStandard.PHP.UselessParentheses
         was tried and left out: it flags the parentheses in ($a ?? 0) ?: null and (a + b) < c, which
         make mixed operators easier to read. -->
    <rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit">
        <properties>
            <property name="ignoreStandaloneIfInScope" value="true"/>
            <property name="ignoreTrailingIfWithOneInstruction" value="true"/>
        </properties>
    </rule>

    <!-- Warnings (cognitive complexity 10-14) are shown but do not fail the run; errors do. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
